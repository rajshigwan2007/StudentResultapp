<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:label="Student Result"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentResultApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">

        <activity android:name=".TeacherDashboardActivity" />
        <activity android:name=".TeacherLoginActivity" />
        <activity
            android:name=".TeacherRegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ViewAllResultsActivity"
            android:exported="false" />

        <activity
            android:name=".ResultActivity"
            android:exported="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>

                <action android:name="android.intent.action.MAIN"/>

                <category
                    android:name="android.intent.category.LAUNCHER"/>

            </intent-filter>

        </activity>

    </application>

</manifest>